<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aplikasi Jurnal Mengajar Guru SMP</title>
    <!-- Tailwind CSS untuk tampilan modern -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @media print {
            body * {
                visibility: hidden;
            }
            #print-area, #print-area * {
                visibility: visible;
            }
            #print-area {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
            }
            .no-print {
                display: none;
            }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans">

    <div class="max-w-5xl mx-auto p-4 sm:p-6">
        <!-- Header -->
        <header class="bg-indigo-600 text-white p-6 rounded-xl shadow-md mb-6 text-center">
            <h1 class="text-2xl font-bold">Jurnal Mengajar Guru SMP</h1>
            <p class="text-indigo-200 text-sm mt-1">Catatan Kegiatan Belajar Mengajar Harian</p>
        </header>

        <!-- Identitas Guru & Sekolah (No Print / Bisa disimpan) -->
        <div class="bg-white p-6 rounded-xl shadow-md mb-6 no-print">
            <h2 class="text-lg font-semibold text-slate-700 mb-4 border-b pb-2">Identitas Pengajar</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-600 mb-1">Nama Guru</label>
                    <input type="text" id="namaGuru" placeholder="Contoh: Nama Anda, S.Pd." class="w-full border border-slate-300 rounded-lg p-2.5 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-600 mb-1">Nama Sekolah</label>
                    <input type="text" id="namaSekolah" placeholder="Contoh: SMP Negeri 1 Ambon" class="w-full border border-slate-300 rounded-lg p-2.5 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                </div>
            </div>
        </div>

        <!-- Form Input Jurnal (No Print) -->
        <div class="bg-white p-6 rounded-xl shadow-md mb-6 no-print">
            <h2 class="text-lg font-semibold text-slate-700 mb-4 border-b pb-2">Formulir Entri Jurnal Pembelajaran</h2>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
                <!-- Tanggal -->
                <div>
                    <label class="block text-sm font-medium text-slate-600 mb-1">Tanggal</label>
                    <input type="date" id="tanggal" class="w-full border border-slate-300 rounded-lg p-2.5 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                </div>

                <!-- Pilihan Kelas -->
                <div>
                    <label class="block text-sm font-medium text-slate-600 mb-1">Kelas</label>
                    <select id="kelas" class="w-full border border-slate-300 rounded-lg p-2.5 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                        <option value="">-- Pilih Kelas --</option>
                        <option value="VII (Tujuh)">Kelas VII</option>
                        <option value="VIII (Delapan)">Kelas VIII</option>
                        <option value="IX (Sembilan)">Kelas IX</option>
                    </select>
                </div>

                <!-- Pilihan Semester -->
                <div>
                    <label class="block text-sm font-medium text-slate-600 mb-1">Semester</label>
                    <select id="semester" class="w-full border border-slate-300 rounded-lg p-2.5 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                        <option value="">-- Pilih Semester --</option>
                        <option value="1 (Ganjil)">Semester 1 (Ganjil)</option>
                        <option value="2 (Genap)">Semester 2 (Genap)</option>
                    </select>
                </div>

                <!-- Pilihan Mata Pelajaran -->
                <div>
                    <label class="block text-sm font-medium text-slate-600 mb-1">Mata Pelajaran</label>
                    <select id="mapel" class="w-full border border-slate-300 rounded-lg p-2.5 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                        <option value="">-- Pilih Mapel --</option>
                        <option value="Pendidikan Agama dan Budi Pekerti">Pendidikan Agama & Budi Pekerti</option>
                        <option value="Pendidikan Pancasila">Pendidikan Pancasila</option>
                        <option value="Bahasa Indonesia">Bahasa Indonesia</option>
                        <option value="Matematika">Matematika</option>
                        <option value="Ilmu Pengetahuan Alam (IPA)">Ilmu Pengetahuan Alam (IPA)</option>
                        <option value="Ilmu Pengetahuan Sosial (IPS)">Ilmu Pengetahuan Sosial (IPS)</option>
                        <option value="Bahasa Inggris">Bahasa Inggris</option>
                        <option value="Seni Budaya">Seni Budaya</option>
                        <option value="Pendidikan Jasmani, Olahraga, dan Kesehatan">PJOK</option>
                        <option value="Informatika">Informatika</option>
                        <option value="Prakarya">Prakarya</option>
                    </select>
                </div>
            </div>

            <!-- Jam Ke & Materi -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-sm font-medium text-slate-600 mb-1">Jam Ke-</label>
                    <input type="text" id="jamKe" placeholder="Contoh: 1 - 3" class="w-full border border-slate-300 rounded-lg p-2.5 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-600 mb-1">Materi / Tujuan Pembelajaran</label>
                    <input type="text" id="materi" placeholder="Contoh: Berpikir Komputasional" class="w-full border border-slate-300 rounded-lg p-2.5 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                </div>
            </div>

            <!-- Catatan / Keterangan -->
            <div class="mb-4">
                <label class="block text-sm font-medium text-slate-600 mb-1">Catatan / Hambatan / Kehadiran Siswa</label>
                <textarea id="catatan" rows="2" placeholder="Contoh: Hadir semua, siswa aktif melakukan praktik." class="w-full border border-slate-300 rounded-lg p-2.5 focus:ring-2 focus:ring-indigo-500 focus:outline-none"></textarea>
            </div>

            <!-- Tombol Aksi -->
            <div class="flex gap-3">
                <button onclick="tambahJurnal()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-5 py-2.5 rounded-lg shadow transition">Tambah ke Jurnal</button>
                <button onclick="resetForm()" class="bg-slate-200 hover:bg-slate-300 text-slate-700 font-medium px-5 py-2.5 rounded-lg transition">Kosongkan Form</button>
            </div>
        </div>

        <!-- Area Cetak / Hasil Rekap Jurnal -->
        <div id="print-area" class="bg-white p-6 rounded-xl shadow-md">
            <!-- Header khusus saat dicetak -->
            <div class="mb-6 border-b pb-4">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                    <div>
                        <h2 class="text-xl font-bold text-slate-800">REKAPITULASI JURNAL MENGAJAR GURU</h2>
                        <div class="text-sm text-slate-600 mt-1 space-y-0.5">
                            <p><strong>Nama Guru:</strong> <span id="displayNamaGuru" class="italic text-slate-500">- Belum diisi -</span></p>
                            <p><strong>Sekolah:</strong> <span id="displayNamaSekolah" class="italic text-slate-500">- Belum diisi -</span></p>
                        </div>
                    </div>
                    <button onclick="window.print()" class="no-print bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium px-4 py-2 rounded-lg shadow transition flex items-center gap-2">
                        🖨️ Cetak / Simpan PDF
                    </button>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="bg-slate-100 text-slate-700 border-b">
                            <th class="p-3 border text-center">No</th>
                            <th class="p-3 border">Tanggal</th>
                            <th class="p-3 border">Kelas / Sem</th>
                            <th class="p-3 border">Mata Pelajaran</th>
                            <th class="p-3 border text-center">Jam</th>
                            <th class="p-3 border">Materi & Catatan</th>
                            <th class="p-3 border no-print text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="tabelJurnal">
                        <!-- Data jurnal akan masuk lewat JavaScript -->
                    </tbody>
                </table>
            </div>

            <!-- Tanda Tangan untuk Cetak -->
            <div class="mt-8 hidden print:block pt-4">
                <div class="flex justify-end text-right">
                    <div>
                        <p class="mb-16">Mengetahui,<br>Kepala Sekolah / Guru Piket</p>
                        <p class="font-bold underline" id="printNamaGuru">( ........................................ )</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Script Logika Aplikasi -->
    <script>
        let dataJurnal = JSON.parse(localStorage.getItem('data_jurnal_smp')) || [];
        let identitas = JSON.parse(localStorage.getItem('identitas_guru')) || { guru: '', sekolah: '' };

        // Muat data identitas saat pertama kali dibuka
        document.getElementById('namaGuru').value = identitas.guru;
        document.getElementById('namaSekolah').value = identitas.sekolah;
        updateIdentitasDisplay();
        renderTabel();

        // Event listener untuk menyimpan identitas secara otomatis saat diketik
        document.getElementById('namaGuru').addEventListener('input', function() {
            identitas.guru = this.value;
            localStorage.setItem('identitas_guru', JSON.stringify(identitas));
            updateIdentitasDisplay();
        });

        document.getElementById('namaSekolah').addEventListener('input', function() {
            identitas.sekolah = this.value;
            localStorage.setItem('identitas_guru', JSON.stringify(identitas));
            updateIdentitasDisplay();
        });

        function updateIdentitasDisplay() {
            const dispGuru = document.getElementById('displayNamaGuru');
            const dispSekolah = document.getElementById('displayNamaSekolah');
            const printGuru = document.getElementById('printNamaGuru');

            dispGuru.textContent = identitas.guru || '- Belum diisi -';
            dispGuru.className = identitas.guru ? 'font-semibold text-slate-800' : 'italic text-slate-500';

            dispSekolah.textContent = identitas.sekolah || '- Belum diisi -';
            dispSekolah.className = identitas.sekolah ? 'font-semibold text-slate-800' : 'italic text-slate-500';

            printGuru.textContent = identitas.guru ? `(${identitas.guru})` : '( ........................................ )';
        }

        function tambahJurnal() {
            const tanggal = document.getElementById('tanggal').value;
            const kelas = document.getElementById('kelas').value;
            const semester = document.getElementById('semester').value;
            const mapel = document.getElementById('mapel').value;
            const jamKe = document.getElementById('jamKe').value;
            const materi = document.getElementById('materi').value;
            const catatan = document.getElementById('catatan').value;

            if (!tanggal || !kelas || !semester || !mapel || !materi) {
                alert('Mohon lengkapi Tanggal, Kelas, Semester, Mapel, dan Materi terlebih dahulu!');
                return;
            }

            const item = { tanggal, kelas, semester, mapel, jamKe, materi, catatan };
            dataJurnal.push(item);
            
            simpanKeStorage();
            renderTabel();
            resetForm();
        }

        function renderTabel() {
            const tbody = document.getElementById('tabelJurnal');
            tbody.innerHTML = '';

            if (dataJurnal.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="text-center p-6 text-slate-400 italic">Belum ada data jurnal yang dimasukkan.</td></tr>`;
                return;
            }

            dataJurnal.forEach((jurnal, index) => {
                const row = `
                    <tr class="border-b hover:bg-slate-50">
                        <td class="p-3 border text-center">${index + 1}</td>
                        <td class="p-3 border whitespace-nowrap">${jurnal.tanggal}</td>
                        <td class="p-3 border">${jurnal.kelas}<br><span class="text-xs text-slate-500">Sem ${jurnal.semester}</span></td>
                        <td class="p-3 border font-medium">${jurnal.mapel}</td>
                        <td class="p-3 border text-center">${jurnal.jamKe || '-'}</td>
                        <td class="p-3 border">
                            <span class="font-semibold text-slate-700">${jurnal.materi}</span>
                            ${jurnal.catatan ? `<br><span class="text-xs text-slate-500 italic">Catatan: ${jurnal.catatan}</span>` : ''}
                        </td>
                        <td class="p-3 border no-print text-center">
                            <button onclick="hapusJurnal(${index})" class="text-red-500 hover:text-red-700 text-xs font-semibold px-2 py-1 rounded bg-red-50 hover:bg-red-100 transition">Hapus</button>
                        </td>
                    </tr>
                `;
                tbody.innerHTML += row;
            });
        }

        function hapusJurnal(index) {
            if (confirm('Apakah Anda yakin ingin menghapus data jurnal ini?')) {
                dataJurnal.splice(index, 1);
                simpanKeStorage();
                renderTabel();
            }
        }

        function simpanKeStorage() {
            localStorage.setItem('data_jurnal_smp', JSON.stringify(dataJurnal));
        }

        function resetForm() {
            document.getElementById('tanggal').value = '';
            document.getElementById('kelas').value = '';
            document.getElementById('semester').value = '';
            document.getElementById('mapel').value = '';
            document.getElementById('jamKe').value = '';
            document.getElementById('materi').value = '';
            document.getElementById('catatan').value = '';
        }
    </script>
</body>
</html>
  
